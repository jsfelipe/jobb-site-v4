<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301: URLs legadas de funcionalidades (site 2023)
  RewriteRule ^funcionalidades/.+ /funcionalidades [R=301,L,NC]

  # SPA fallback
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
